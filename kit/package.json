{
  "name": "@portrayal/kit",
  "version": "0.51.0",
  "description": "Read, draw, inspect and export Portrayal device artifacts. Consumes compiled SVG + JSON; never reads YAML.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roc-ops/Portrayal.git",
    "directory": "kit"
  },
  "homepage": "https://github.com/roc-ops/Portrayal/tree/main/kit#readme",
  "bugs": {
    "url": "https://github.com/roc-ops/Portrayal/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "cp ../LICENSE ../NOTICE .",
    "postpack": "rm -f LICENSE NOTICE",
    "test": "node --check shell.js && node --check viewer3d.js && node --check relief.js && node --check lamps.js && node --check marks.js && node --check fields.js && node --check displays.js && node --check states.js && node --check dist.js && node --check swap.js && node --check share.js && node --check devsel.js && node --check nosnames.js && node --check gif.js && node --check optical.js && node --check zones.js && node --check bevel.js && node --check camera-fit.js &&node --check drawio.js && node --check omnigraffle.js && node --check ears2d.js && node --check positions.js && node --check redirects.js && for f in rack/*.js; do node --check $f || exit 1; done && for f in rack/view/*.js; do node --check $f || exit 1; done"
  },
  "exports": {
    "./shell": "./shell.js",
    "./viewer3d": "./viewer3d.js",
    "./relief": "./relief.js",
    "./marks": "./marks.js",
    "./fields": "./fields.js",
    "./displays": "./displays.js",
    "./states": "./states.js",
    "./share": "./share.js",
    "./gif": "./gif.js",
    "./swap": "./swap.js",
    "./devsel": "./devsel.js",
    "./nosnames": "./nosnames.js",
    "./dist": "./dist.js",
    "./optical": "./optical.js",
    "./zones": "./zones.js",
    "./bevel": "./bevel.js",
    "./camera-fit": "./camera-fit.js",
    "./drawio": "./drawio.js",
    "./omnigraffle": "./omnigraffle.js",
    "./ears2d": "./ears2d.js",
    "./positions": "./positions.js",
    "./redirects": "./redirects.js",
    "./rack/cable-geometry": "./rack/cable-geometry.js",
    "./rack/cable-rules": "./rack/cable-rules.js",
    "./rack/cable-types": "./rack/cable-types.js",
    "./rack/bundle-route": "./rack/bundle-route.js",
    "./rack/bundles": "./rack/bundles.js",
    "./rack/catalog": "./rack/catalog.js",
    "./rack/commands": "./rack/commands.js",
    "./rack/dcim-rules": "./rack/dcim-rules.js",
    "./rack/displays": "./rack/displays.js",
    "./rack/editor": "./rack/editor.js",
    "./rack/export-data": "./rack/export-data.js",
    "./rack/fit": "./rack/fit.js",
    "./rack/frames": "./rack/frames.js",
    "./rack/history": "./rack/history.js",
    "./rack/managers": "./rack/managers.js",
    "./rack/model": "./rack/model.js",
    "./rack/ports": "./rack/ports.js",
    "./rack/queries": "./rack/queries.js",
    "./rack/rails": "./rack/rails.js",
    "./rack/route": "./rack/route.js",
    "./rack/route-path": "./rack/route-path.js",
    "./rack/slack": "./rack/slack.js",
    "./rack/solids": "./rack/solids.js",
    "./rack/states": "./rack/states.js",
    "./rack/validate": "./rack/validate.js",
    "./rack/zero-u": "./rack/zero-u.js",
    "./rack/view/view": "./rack/view/view.js",
    "./rack/view/elevation": "./rack/view/elevation.js",
    "./rack/view/dom": "./rack/view/dom.js",
    "./rack/view/face": "./rack/view/face.js",
    "./rack/view/faces": "./rack/view/faces.js",
    "./rack/view/ear-holes": "./rack/view/ear-holes.js",
    "./rack/view/settable": "./rack/view/settable.js"
  },
  "peerDependencies": {
    "three": "^0.161.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "files": [
    "*.js",
    "rack/*.js",
    "rack/view/*.js",
    "portrayal.png",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
