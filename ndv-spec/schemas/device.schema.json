{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndv.dev/schemas/v0/device.schema.json",
  "title": "NDV device manifest (v0)",
  "type": "object",
  "required": [
    "format",
    "kind",
    "name",
    "version",
    "manufacturer",
    "model",
    "chassis",
    "views"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "kind": {
      "const": "device"
    },
    "name": {
      "$ref": "#/$defs/segment"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "part-numbers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/segment"
    },
    "datasheet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "archive": {
          "type": "string"
        }
      }
    },
    "references": {
      "type": "array",
      "description": "additional source documents (guides, HIGs) registered like the datasheet",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "archive": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "attrs": {
      "type": "object"
    },
    "chassis": {
      "type": "object",
      "required": [
        "width",
        "height",
        "depth"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        },
        "ru": {
          "type": "number"
        },
        "weight-kg": {
          "type": "number"
        },
        "airflow": {
          "enum": [
            "front-to-back",
            "back-to-front",
            "side",
            "passive"
          ]
        },
        "color": {
          "type": "string",
          "description": "housing color (faceplate fill); default dark"
        },
        "edge": {
          "type": "string"
        },
        "silk": {
          "type": "string",
          "description": "silkscreen/label text color; default light"
        }
      }
    },
    "configurations": {
      "type": "object",
      "description": "renderable variants: bay population, skin choices, airflow/region context",
      "propertyNames": {
        "$ref": "#/$defs/segment"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "airflow": {
            "enum": [
              "front-to-back",
              "back-to-front"
            ]
          },
          "bays": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "skins": {
            "type": "object",
            "description": "component name -> skin name",
            "additionalProperties": {
              "$ref": "#/$defs/segment"
            }
          },
          "region-context": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "part-numbers": {
            "type": "object",
            "description": "orderable SKUs for this configuration: model -> {part, power-cord}",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "part": {
                  "type": "string"
                },
                "power-cord": {
                  "type": "string"
                }
              }
            }
          },
          "component-attrs": {
            "type": "object",
            "description": "component name -> extra data-* attrs (FRU model/part-number per config)",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "description": "component groups: numbering + shared attrs, e.g. ports",
      "propertyNames": {
        "$ref": "#/$defs/segment"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index-origin": {
            "enum": [
              0,
              1
            ]
          },
          "term": {
            "type": "string",
            "description": "vendor display word, e.g. 'Port', 'Slot', 'Bay'"
          },
          "attrs": {
            "type": "object"
          }
        }
      }
    },
    "views": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "front"
      ],
      "propertyNames": {
        "$ref": "#/$defs/segment"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "object",
            "description": "view dimensions in mm when not the chassis front elevation (e.g. top = width x depth)",
            "required": [
              "w",
              "h"
            ],
            "additionalProperties": false,
            "properties": {
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+/[a-z0-9-]+@\\d+$",
                  "description": "namespace/component@major"
                },
                "id": {
                  "$ref": "#/$defs/segment"
                },
                "at": {
                  "$ref": "#/$defs/xy"
                },
                "rotate": {
                  "type": "number"
                },
                "skin": {
                  "$ref": "#/$defs/segment"
                },
                "group": {
                  "$ref": "#/$defs/segment"
                },
                "rel-pos": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "label-at": {
                  "$ref": "#/$defs/xy",
                  "description": "label position relative to component origin; default below center"
                },
                "label-anchor": {
                  "enum": [
                    "start",
                    "middle",
                    "end"
                  ]
                },
                "label-size": {
                  "type": "number",
                  "description": "font size in mm; default 2.2. Multi-line labels use \n"
                },
                "label-color": {
                  "type": "string",
                  "description": "label text color; default chassis silk"
                },
                "optional": {
                  "$ref": "#/$defs/segment",
                  "description": "render only when --with <tag> is given (e.g. ears)"
                },
                "attrs": {
                  "type": "object"
                },
                "provenance": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "mate-to": {
                  "$ref": "#/$defs/segment",
                  "description": "id of a placement in this view to mate into. The renderer positions this component so its `mate` connection-point coincides with the host's, so an occupant never carries hand-computed centring offsets. Mutually exclusive with `at`."
                }
              },
              "oneOf": [
                {
                  "required": [
                    "at"
                  ]
                },
                {
                  "required": [
                    "mate-to"
                  ]
                }
              ]
            }
          },
          "bays": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "at",
                "size",
                "accepts"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/segment"
                },
                "at": {
                  "$ref": "#/$defs/xy"
                },
                "size": {
                  "type": "object",
                  "required": [
                    "w",
                    "h"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "w": {
                      "type": "number"
                    },
                    "h": {
                      "type": "number"
                    }
                  }
                },
                "accepts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "group": {
                  "$ref": "#/$defs/segment"
                },
                "rel-pos": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "label-at": {
                  "$ref": "#/$defs/xy"
                },
                "label-anchor": {
                  "enum": [
                    "start",
                    "middle",
                    "end"
                  ]
                },
                "label-size": {
                  "type": "number"
                },
                "label-color": {
                  "type": "string"
                },
                "default": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "ref populated by default config; null = open"
                }
              }
            }
          },
          "decor": {
            "type": "array",
            "description": "non-addressable chassis decoration (vent fields etc.)",
            "items": {
              "type": "object",
              "required": [
                "at"
              ],
              "additionalProperties": false,
              "properties": {
                "at": {
                  "$ref": "#/$defs/xy"
                },
                "size": {
                  "$ref": "#/$defs/xy"
                },
                "pattern": {
                  "enum": [
                    "vent",
                    "holes",
                    "slots",
                    "slots-h",
                    "ribs"
                  ]
                },
                "vent": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "air vent: dark cells (or the whole rect when plain-fill) become holes into a cavity this deep in 3D"
                },
                "pattern-offset": {
                  "$ref": "#/$defs/xy",
                  "description": "shift the pattern phase under this rect (align lattice rows across corners)"
                },
                "out": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "decor protrudes this many mm from the face in 3D (raised stampings)"
                },
                "sink": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "decor is recessed this many mm into the face in 3D (pressed grooves)"
                },
                "fill": {
                  "type": "string",
                  "description": "plain fill (e.g. groove color) when no pattern"
                },
                "rx": {
                  "type": "number"
                },
                "stroke": {
                  "type": "string",
                  "description": "outline-only decor (fiber channels etc.); fill defaults to none"
                },
                "stroke-width": {
                  "type": "number"
                },
                "text": {
                  "type": "string",
                  "description": "silkscreen text decor (needs no size)"
                },
                "rotate": {
                  "type": "number",
                  "description": "text decor rotation in degrees about its anchor"
                },
                "font-size": {
                  "type": "number"
                },
                "anchor": {
                  "enum": [
                    "start",
                    "middle",
                    "end"
                  ]
                }
              }
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/segment"
                },
                "at": {
                  "$ref": "#/$defs/xy"
                },
                "size": {
                  "type": "object",
                  "required": [
                    "w",
                    "h"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "w": {
                      "type": "number"
                    },
                    "h": {
                      "type": "number"
                    }
                  }
                },
                "physical-context": {
                  "type": "string",
                  "description": "Redfish PhysicalContext value where applicable"
                },
                "members": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/segment"
                  }
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "xy": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
