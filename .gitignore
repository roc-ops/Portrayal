# ---- vendor material: NEVER publishable -------------------------------------
# Spec PDFs are copyrighted; TE/Schurter CAD is licensed for design use, not
# redistribution; Visio stencils (VisioCafe/VSD Grafx) forbid redistribution and
# modification. We transcribe FACTS into the registry and cite the source - the
# source files themselves stay local.
working/
**/reference/

# belt and braces: even outside working/, these formats are never ours to ship
*.pdf
*.stp
*.step
*.igs
*.iges
*.dxf
*.vss
*.vssx
*.vsd
*.vsdx
*.emf
*.wmf

# ---- device photos ----------------------------------------------------------
# Field photos of customer/lab hardware. Metrology inputs, not artifacts.
*.jpg
*.jpeg
*.heic
*.png
!library/**/skins/**/*.png
!docs/**/*.png
# The product's own mark, supplied by the Portrayal site. Ours to ship, and
# the only PNG in the repo that is branding rather than a metrology input -
# hence a named exception rather than `git add -f`, which would leave the next
# person wondering how it got past the rule.
!library/demo2/portrayal.png

# ---- build + scratch --------------------------------------------------------
dist/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
.playwright-mcp/

# Agent worktrees. `git worktree add` under .claude/ puts a whole checkout inside
# the repo, and a broad `git add` swallows it as an embedded git repository -
# which happened once and had to be amended out. Nothing in here belongs to this
# tree; it belongs to whoever created the worktree.
.claude/worktrees/
